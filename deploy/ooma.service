[Unit]
Description=ooma recursive learning loop (paper only)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=600
WorkingDirectory=%h/ooma
ExecStart=%h/ooma/.venv/bin/ooma run
Restart=always
RestartSec=30
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
